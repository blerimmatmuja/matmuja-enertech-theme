{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "color": {
      "palette": [
        { "slug": "brand-cyan",   "color": "#00b4ff", "name": "Brand Cyan" },
        { "slug": "brand-mint",   "color": "#00ffcc", "name": "Brand Mint" },
        { "slug": "phase-cyan",   "color": "#00b4ff", "name": "Phase 1 (Planung)" },
        { "slug": "phase-orange", "color": "#ff8c00", "name": "Phase 2 (Tiefbau)" },
        { "slug": "phase-mint",   "color": "#00ffcc", "name": "Phase 3 (Verlegung)" },
        { "slug": "phase-purple", "color": "#bf00ff", "name": "Phase 4 (Spleißen)" },
        { "slug": "phase-green",  "color": "#00ff88", "name": "Phase 5 (Hausanschluss)" },
        { "slug": "bg",           "color": "#060610", "name": "Background" },
        { "slug": "bg-card",      "color": "#020408", "name": "Background Card" },
        { "slug": "text",         "color": "#e0e8ff", "name": "Text" },
        { "slug": "text-muted",   "color": "#506080", "name": "Text Muted" }
      ]
    },
    "typography": {
      "fontFamilies": [
        { "fontFamily": "'Inter', 'Segoe UI', system-ui, sans-serif", "slug": "body", "name": "Inter" },
        { "fontFamily": "'Space Grotesk', 'Inter', system-ui, sans-serif", "slug": "display", "name": "Space Grotesk" }
      ]
    },
    "spacing": { "units": ["px", "em", "rem", "%", "vh", "vw"] },
    "layout":  { "contentSize": "800px", "wideSize": "1380px" }
  },
  "styles": {
    "color":      { "background": "#060610", "text": "#e0e8ff" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "lineHeight": "1.7" }
  }
}
